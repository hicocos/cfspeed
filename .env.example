# 推荐在 Web 填写 DNS/通知凭据，会加密保存；环境变量兼容值仍为明文。
CF_API_TOKEN=
DNSPOD_SECRET_ID=
DNSPOD_SECRET_KEY=
PUSHPLUS_TOKEN=
# 公网部署时配置固定 HTTPS 来源；本机演示可留空。
CFSPEED_PUBLIC_ORIGIN=
# 显式指定独立、32 原始字节、0600 的文件；指定时不自动生成。
# CFSPEED_MASTER_KEY_FILE=/run/secrets/cfspeed-master-key
# 只填写真实反代来源，绝不能用 0.0.0.0/0。网关变化时重新核对。
CFSPEED_TRUSTED_PROXIES=
